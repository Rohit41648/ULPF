# Copy this file to .env and adjust as needed. No secrets are committed.

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=ulpf
POSTGRES_PASSWORD=ulpf_local_dev
POSTGRES_DB=ulpf

# --- Backend ---
# Overridden automatically inside docker-compose to point at the postgres
# service; only needed if running the backend outside Docker.
# DATABASE_URL=postgresql+psycopg2://ulpf:ulpf_local_dev@localhost:5432/ulpf
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_BYTES=262144

# Application-layer encryption for browser -> backend payloads
ENCRYPTION_ENABLED=true
# Optional: override the default backend/keys/*.pem paths
# ENCRYPTION_PRIVATE_KEY_PATH=backend/keys/receiver_private.pem
# ENCRYPTION_PUBLIC_KEY_PATH=backend/keys/receiver_public.pem

# Optional: enables LLM-assisted (rather than purely heuristic) unknown-source
# field inference. Leave blank — onboarding works fully without it.
# To enable Gemini: set LLM_PROVIDER=gemini and put your key in LLM_API_KEY
# (get one free at https://aistudio.google.com/apikey).
GCP_API_KEY=your_gcp_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
